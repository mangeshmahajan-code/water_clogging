# ==========================================
# Water Clogging Reporter - Environment Config
# ==========================================

# Required Production Variables
SECRET_KEY=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
GOVERNMENT_AUTHORITY_EMAIL=

# Mail Server Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False

# Production Rate Limiting Storage (e.g. Redis for multi-worker Gunicorn)
RATELIMIT_STORAGE_URL=

# Security & Cookie Configuration (Defaults to True in production)
SESSION_COOKIE_SECURE=True
REMEMBER_COOKIE_SECURE=True
ENABLE_HSTS=True

# Application Modes (Defaults to False in production)
FLASK_DEBUG=False
TESTING=False
